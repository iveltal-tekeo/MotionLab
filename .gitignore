# MotionLab - only code, docs and shared knowledge go into the repo. Everything personal stays on your PC.

# --- your data (videos, analyses, edits, renders) - never in git
/refs/*
!/refs/README.md
/analysis/
/projects/*
!/projects/README.md
/library/
/settings.json
/tools/config.local.json

# --- knowledge: knowledge/references (cards) and knowledge/incoming (lessons to review) are shared; these stay here
/knowledge/local/
/knowledge/inbox/
/knowledge/outbox/

# --- personal hand-off notes (not useful to others)
/docs/option2_prompt.md
# a talking-head editing kit kept for reference while 0.6.0's steps 20-23 are built (no licence: never in the repo)
/kit_editor_claude/

# --- Python
/.venv/
__pycache__/
*.pyc

# --- generated / caches
/.app/
/docs/roadmap.mp4
/tools/selftest/
/tools/bin/

# --- Claude Code local state (keep the skills + lessons = shared knowledge, and the cloud-session hook)
/.claude/*
!/.claude/skills/
!/.claude/settings.json
!/.claude/hooks/
/.claude/settings.local.json

# --- Windows
Thumbs.db
desktop.ini

# --- overlays: Node packages (setup.bat runs npm ci from package-lock.json)
/tools/overlays/node_modules/
