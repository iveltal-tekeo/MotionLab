{
 "name": "Paper sweep transition",
 "kind": "transitions",
 "category": "Graphics",
 "what": "From one scene to the next: a curved sheet tumbles in from the top right and sweeps down to the bottom left; behind it the first scene blurs out and the second crossfades in through the blur, then sharpens.",
 "use_for": [
  "transition",
