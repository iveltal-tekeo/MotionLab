  "sweep",
  "blur",
  "crossfade",
  "two scenes",
  "needs media"
 ],
 "learned_from": [],
 "origin": "MotionLab's own build in the Editorial warm look (2026-10)",
 "motion": "f0-f95 scene A pushes in 6 % (sine); f52-f68 the sheet snaps in from the top right (expo out), f68-f160 drifts down-left while it turns (power1 in-out), f160-f190 leaves past the bottom left (expo in); f60-f95 A blurs out (accelerating); f83-f108 B crossfades in through the blur; f108-f165 B sharpens (decelerating); then B pushes in slowly",
 "tracks": [
  {
   "name": "scene A",
   "what": "a slow push-in (scale 1 -> 1.06)",
   "start_f": 0,
   "length_f": 95,
   "easing": "sine.inOut"
  },
  {
   "name": "sheet in",
   "what": "snaps in from beyond the top right",
   "start_f": 52,
   "length_f": 16,
   "easing": "expo.out (cubic-bezier(0.16, 1, 0.3, 1))"
  },
  {
   "name": "sheet drift",
   "what": "drifts down-left, turning 70 deg",
   "start_f": 68,
   "length_f": 92,
   "easing": "power1.inOut"
  },
  {
   "name": "sheet out",
   "what": "leaves past the bottom left",
   "start_f": 160,
   "length_f": 30,
   "easing": "expo.in (cubic-bezier(0.7, 0, 0.84, 0))"
  },
  {
   "name": "A blur",
   "what": "scene A blurs out",
   "start_f": 60,
   "length_f": 35,
   "easing": "power2.in"
  },
  {
   "name": "crossfade",
   "what": "scene B fades in, still blurred",
   "start_f": 83,
   "length_f": 25,
   "easing": "power1.inOut"
  },
  {
   "name": "B sharpens",
   "what": "the blur clears",
   "start_f": 108,
   "length_f": 57,
   "easing": "power3.out"
  },
  {
   "name": "scene B",
   "what": "a slow push-in",
   "start_f": 165,
   "length_f": 107,
   "easing": "sine.inOut"
  }
 ],
